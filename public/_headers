# Cache headers for Netlify / Cloudflare Pages. GitHub Pages ignores this file
# (it fixes Cache-Control at max-age=600).
# Fonts and images never change under the same name, so they can be cached for a year.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# JS and CSS keep fixed filenames (no content hash), so revalidate instead of "immutable".
/assets/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
